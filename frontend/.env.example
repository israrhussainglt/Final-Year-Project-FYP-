# URL of the pulseid-backend API, reachable from the *browser* (used by
# client components and baked into the build). Point this at your deployed
# API in production, e.g. https://api.pulseid.example
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL of the API reachable from the *Next.js server* (server components /
# middleware). Usually the same as above; split out in case your deployment
# uses an internal/private URL for server-to-server calls (e.g. Docker
# service name) that differs from the public one used by the browser.
API_INTERNAL_URL=http://localhost:4000

# MUST be identical to the backend's SESSION_SECRET — the frontend uses it
# only to verify (never sign) session JWTs in middleware.ts, so page routes
# can be protected without an extra network round-trip on every navigation.
SESSION_SECRET=change-this-to-a-long-random-string
