# Copy this file to .env in the project root before running `docker compose up`.
# These values are consumed by docker-compose.yml for the backend container.

# REQUIRED. Long random string, must match the frontend's SESSION_SECRET
# (frontend only verifies session JWTs, never signs them). Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Frontend origin allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:3000

# Public URL of the frontend — used to build emergency QR links.
PUBLIC_APP_URL=http://localhost:3000

# Port to expose the backend on the host.
BACKEND_PORT=4000

# MUST be false in any real deployment (leaks OTP codes in API responses).
DEMO_MODE=false

# Optional — only if frontend/backend are on different subdomains of the
# same parent domain and you want the session cookie shared.
COOKIE_DOMAIN=

# Shared secret between the backend and the analytics service. Generate with
# `openssl rand -hex 32`. Must match ANALYTICS_SERVICE_KEY in analytics/.env.local.
ANALYTICS_SERVICE_KEY=
ANALYTICS_SESSION_SECRET=
ANALYTICS_ADMIN_EMAIL=
ANALYTICS_ADMIN_PASSWORD=
ANALYTICS_PORT=3100
# Optional — enables AI features in the analytics app (Ask, Alerts
# briefing, Bulletins, Resources). Set one provider; leave both blank to
# run without them.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Cron schedules for the analytics-scheduler container (weekly bulletin,
# monthly bulletin). Standard 5-field cron syntax.
BULLETIN_WEEKLY_CRON=0 6 * * 1
BULLETIN_MONTHLY_CRON=0 6 1 * *
