{
  "name": "pulseid-backend",
  "version": "1.0.0",
  "private": true,
  "description": "PulseID API server \u2014 auth, patient records, emergency QR, and audit logging.",
  "main": "dist/server.js",
  "scripts": {
    "predev": "node scripts/seed.js",
    "dev": "tsx watch src/server.ts",
    "prebuild": "node scripts/seed.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "node scripts/seed.js --force",
    "reminders": "tsx scripts/reminder-scheduler.ts",
    "followups": "tsx scripts/followup-scheduler.ts",
    "test": "vitest run",
    "rag": "cd rag && python run.py",
    "rag:test": "cd rag && python -m pytest tests",
    "test:coverage": "vitest run --coverage",
    "postinstall": "node scripts/ensure-sqlite-shim.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jose": "^5.9.6",
    "multer": "^2.4.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.16.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.16",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "libsql": "^0.5.29",
    "supertest": "^7.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
