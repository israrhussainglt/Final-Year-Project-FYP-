# Secret used to sign & verify session JWTs. MUST be identical to the
# SESSION_SECRET used by the frontend (frontend only verifies, never signs).
SESSION_SECRET=change-this-to-a-long-random-string

# Port the API listens on.
PORT=4000

# Comma-separated list of frontend origins allowed to call this API with
# credentials (cookies). Add your deployed frontend URL here in production.
CORS_ORIGIN=http://localhost:3000

# Public URL of the *frontend* app — used to build the /emergency/:token
# links embedded in generated QR codes. In production set this to your
# real frontend domain, e.g. https://app.pulseid.example
PUBLIC_APP_URL=http://localhost:3000

# Set automatically by most hosts; set explicitly to "production" to enable
# secure, cross-site cookies (Secure + SameSite=None). The server also
# refuses to start in production with a default SESSION_SECRET or DEMO_MODE=true.
NODE_ENV=development

# Demo mode returns OTP codes directly in the login API response so testers
# can sign in without a real SMS gateway wired up. Defaults to the opposite
# of NODE_ENV=production, but you can force it explicitly. This MUST be
# false (or unset) in any real deployment — leaving it on lets anyone log in
# as any patient without ever seeing their phone.
DEMO_MODE=true

# Optional: only needed if the frontend and backend are deployed on
# different subdomains of the same parent domain (e.g. app.x.com /
# api.x.com) and you want the session cookie shared between them.
# COOKIE_DOMAIN=.pulseid.example

# Twilio credentials for sending real OTP codes by SMS. Required once
# DEMO_MODE=false — without these, request-otp will still work but the code
# will never actually reach the patient's phone (the server logs a warning
# at startup if this happens). Get these from https://console.twilio.com.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# SMTP credentials for sending appointment reminder emails (the reminder
# scheduler — `npm run reminders` — checks these at send time). Optional:
# reminders will still send by SMS alone if only Twilio is configured, and
# if neither is configured the scheduler just logs what it would have sent
# (useful in dev). SMTP_PORT defaults to 587; set it to 465 for implicit TLS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="PulseID <no-reply@pulseid.example>"

# Cron expression for how often the reminder scheduler sweeps for
# appointments to remind about. Defaults to every 15 minutes.
# REMINDER_CRON="*/15 * * * *"

# Cron expression for how often the proactive follow-up scheduler
# (scripts/followup-scheduler.ts) sweeps for due check-ins to send.
# Defaults to once an hour — follow-up cadences are measured in days, so
# this comfortably catches every agent close to its due time.
# FOLLOWUP_CRON="0 * * * *"

# Shared secret the analytics service must send as the `x-analytics-key`
# header on every /api/analytics/* request. This is service-to-service auth
# (not a user session) — generate with `openssl rand -hex 32` and set the
# same value as ANALYTICS_SERVICE_KEY in analytics/.env.local. If unset,
# the analytics routes refuse all requests (503) rather than staying open.
ANALYTICS_SERVICE_KEY=change-this-to-a-long-random-string

# Enables the one AI feature this backend has: the "Summarize load"
# briefing on the hospital-admin Appointments page. Set ONE of the two
# providers below — OpenRouter is used automatically if OPENROUTER_API_KEY
# is set, otherwise Anthropic if ANTHROPIC_API_KEY is set. If neither is
# set, that button still renders but returns a clear "not configured"
# message (503) instead of failing the rest of the page. Only ever sees
# aggregate appointment counts — never patient names or clinical details.

# Option A — OpenRouter (https://openrouter.ai/keys).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_SITE_URL=http://localhost:4000

# Option B — Anthropic direct (https://console.anthropic.com).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
