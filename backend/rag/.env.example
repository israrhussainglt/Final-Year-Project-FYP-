# PulseID RAG service — backend/rag/.env
# Copy this file to .env and fill in the values. Never commit the real .env.

# Groq (https://console.groq.com) — powers the AI report drafter. Retrieval
# and indexing work without a key; only POST /draft needs one.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Port the service listens on. The Node client's RAG_SERVICE_URL (backend/.env)
# must point at this host:port.
RAG_PORT=8100

# Optional shared secret between the Node backend and this service. When set
# here, set the same value as RAG_SERVICE_TOKEN in backend/.env. Leave empty
# for local loopback development.
RAG_SERVICE_TOKEN=

# Embeddings: fastembed runs all-MiniLM-L6-v2 locally via ONNX (~90 MB model
# download into data/models on first start — no torch). "fake" is a
# deterministic test backend, never use it in production.
RAG_EMBEDDING_BACKEND=fastembed
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Index tuning (defaults match the original pipeline).
# RAG_CHUNK_SIZE=1200
# RAG_CHUNK_OVERLAP=150
# RAG_MAX_CHUNKS=5
